<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Apple Pay. O merchant precisa existir no Apple Developer (Merchant ID
	     merchant.br.app.jurandir) e a capability "Apple Pay" habilitada no App ID
	     br.app.jurandir, senão o perfil de assinatura não inclui o direito. -->
	<key>com.apple.developer.in-app-payments</key>
	<array>
		<string>merchant.br.app.jurandir</string>
	</array>
</dict>
</plist>
